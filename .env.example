# Copy this file to .env for local development (python-dotenv loads it automatically
# if you `pip install python-dotenv` and add `from dotenv import load_dotenv; load_dotenv()`
# at the top of app.py — or just export these in your shell).

SECRET_KEY=change-this-to-something-random
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@1984

# Leave DATABASE_URL unset locally to use SQLite (app.db) automatically.
# On Render, this is provided by the attached Postgres database.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: real SMTP so "forgot password" emails actually get delivered.
# If left blank, emails are only logged to the Admin > Email Outbox page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@waskoacademy.com
